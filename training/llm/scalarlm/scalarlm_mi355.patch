-    uint32_t slot = st.write_slot;
-    uint64_t gen  = st.next_gen;
-
-    auto cpu_opts = torch::TensorOptions().dtype(tensor.dtype()).device(torch::kCPU);
-    torch::Tensor shm_tensor = torch::from_blob(ch.send_slot_data(slot),
