-// ---------------------------------------------------------------------------
-// Discovery
-// ---------------------------------------------------------------------------
-
-void shm_discover_peers() {
-    if (g_discovery_done) return;
-
-    ensure_mpi_initialized();
-    int rank, size;
-    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
-    MPI_Comm_size(MPI_COMM_WORLD, &size);
